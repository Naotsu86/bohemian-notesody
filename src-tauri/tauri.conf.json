{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",

  "productName": "Bohemian Notesody",
  "version": "0.1.0",
  "identifier": "de.bohemian.notesody",

  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173/bohemian-notesody/",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },

  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bohemian Notesody",

        "width": 370,
        "height": 560,

        "minWidth": 370,
        "minHeight": 560,

        "resizable": false,
        "fullscreen": false,

        "decorations": false,

        "alwaysOnTop": true,
        "skipTaskbar": false,

        "center": true,

        "visible": false
      }
    ],

    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",

    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}